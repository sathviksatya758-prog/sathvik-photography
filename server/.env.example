# ============================================================
# Copy to .env and fill in. Nothing here is a real secret.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Public URL of this API, used in emails / CORS reflection
API_BASE_URL=http://localhost:4000
# Public URL of the frontend (index.html), used for CORS + email links
CLIENT_ORIGIN=http://localhost:8080

# --- Database (Postgres 16+ with pgvector) ---
DATABASE_URL=postgresql://sathvik:sathvik@localhost:5432/sathvik_portfolio

# --- Redis (rate limiting, caching, BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# 32+ byte random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# First account to register with this email is auto-promoted to admin. Everyone else is "user".
OWNER_EMAIL=sathviksatya758@gmail.com

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage, MinIO) ---
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sathvik-portfolio
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL images are served from (CDN or bucket public URL)
CDN_BASE=http://localhost:9000/sathvik-portfolio

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-changeme
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=sk-changeme
EMBED_MODEL=text-embedding-3-small

# --- Email (SMTP — works with SES, SendGrid, Resend, Mailtrap, MailDev, Gmail app-password, etc.) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Katnam Sathvik <no-reply@sathviksatya.dev>"
# Where "Real Contact Form" submissions are forwarded
CONTACT_TO_EMAIL=sathviksatya758@gmail.com

# --- Uploads ---
MAX_UPLOAD_MB=25
