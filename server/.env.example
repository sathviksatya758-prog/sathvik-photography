# ============================================================
# Copy to .env and fill in DATABASE_URL. Everything else is
# OPTIONAL — leave a block commented out and the app runs in a
# local/in-memory fallback for that service (see the note on
# each block). Nothing here is a real secret.
#
#   Bare minimum to run: NODE_ENV + DATABASE_URL.
#   Full guide: ../docs/RUN_ON_WINDOWS.md
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Public URL of this API, used in emails / CORS reflection / local media URLs
API_BASE_URL=http://localhost:4000
# Public URL of the frontend (index.html), used for CORS + email links.
# In dev the API also reflects any localhost/127.0.0.1 origin automatically.
CLIENT_ORIGIN=http://localhost:8080

# --- Database (Postgres 16+ with pgvector) — REQUIRED ---
# Local install, or a free cloud Postgres with pgvector built in
# (Neon / Supabase). See docs/RUN_ON_WINDOWS.md.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth ---
# Optional in dev (insecure defaults are used if unset). REQUIRED in
# production — the server refuses to boot with the defaults when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
# First account to register with this email is auto-promoted to admin. Everyone else is "user".
OWNER_EMAIL=sathviksatya758@gmail.com

# --- Redis (OPTIONAL) ---
# Enables cross-process caching, Redis-backed rate limiting, and the BullMQ
# job queue drained by `npm run worker`. If unset: in-memory cache + rate
# limiting, and image jobs run INLINE in the API process (no worker needed).
# REDIS_URL=redis://localhost:6379

# --- Object storage (OPTIONAL, S3-compatible: AWS S3, Cloudflare R2, Supabase, MinIO) ---
# If unset: uploaded originals + renditions are written to ./storage on local
# disk and served from ${API_BASE_URL}/media/... — uploads work with no S3.
# Set ALL THREE of S3_BUCKET/S3_KEY/S3_SECRET to switch to S3.
# S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=
# S3_KEY=
# S3_SECRET=
# S3_FORCE_PATH_STYLE=true
# CDN_BASE=http://localhost:9000/your-bucket
# LOCAL_STORAGE_DIR=storage

# --- AI (OPTIONAL) ---
# ANTHROPIC_API_KEY enables AI captions/story/tags/critique/chat + insights
# narrative. OPENAI_API_KEY enables real semantic-search embeddings. If unset:
# uploads still get renditions/EXIF/palette and a plain metadata record, search
# falls back to a deterministic (non-semantic) index, and chat answers from
# archive stats. Add the keys later and re-run a photo via POST /uploads/:id/retry.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# --- Email (OPTIONAL, SMTP: SES, SendGrid, Resend, Mailtrap, MailDev, Gmail app-password) ---
# If unset: emails (verification/reset/contact) are LOGGED to the server console
# instead of sent — links are still recoverable there. Auth works without email.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM="Katnam Sathvik <no-reply@sathviksatya.dev>"
# Where "Real Contact Form" submissions are forwarded
CONTACT_TO_EMAIL=sathviksatya758@gmail.com

# --- Uploads ---
MAX_UPLOAD_MB=25
